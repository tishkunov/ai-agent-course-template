# Все переменные окружения сервиса. Значений здесь нет — заполняются в .env (в .gitignore).
# Отсутствие обязательной переменной → падение на старте с понятным сообщением (M1.1).

# APP_ENV: local | dev | prod
APP_ENV=
# DATABASE_URL: async DSN, формат postgresql+asyncpg://user:pass@host:5432/db
DATABASE_URL=
# REDIS_URL: redis://host:6379/0
REDIS_URL=
# JWT_SECRET: секрет подписи операторских токенов (обязателен, без дефолта)
JWT_SECRET=
# JWT_TTL_MIN: время жизни операторского токена в минутах (по умолчанию 60)
JWT_TTL_MIN=
# API_KEYS: ключи приёма через запятую, например key1,key2
API_KEYS=
# LOG_LEVEL: DEBUG | INFO | WARNING | ERROR (по умолчанию INFO)
LOG_LEVEL=
# DB_POOL_SIZE / DB_MAX_OVERFLOW: границы пула соединений (опционально)
DB_POOL_SIZE=
DB_MAX_OVERFLOW=
